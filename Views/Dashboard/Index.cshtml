@model DashboardVm
@{
    ViewData["Title"] = "Overview";
    var first = (User.Identity.Name ?? "").Split(' ')[0];
}
@if (Model.Role == Roles.Admin)
{
    <div class="page-head"><div><h1 class="page-title">Overview</h1><p class="page-sub">Where the business stands today</p></div></div>
    <div class="stats">
        <div class="stat"><span class="figure">@Model.OpenOrders</span><span class="label">Orders in progress</span></div>
        <div class="stat"><span class="figure">@Model.ActiveConnections</span><span class="label">Active connections</span></div>
        <div class="stat"><span class="figure">@Model.Employees</span><span class="label">Employees</span></div>
        <div class="stat @(Model.Stock.Any(s => s.Shortfall > 0) ? "is-alert" : "")"><span class="figure">@Model.Stock.Count</span><span class="label">Stock lines to reorder</span></div>
    </div>
    <div class="row g-4">
        <div class="col-xl-7">
            <div class="panel">
                <div class="panel-head"><h2>Stock against waiting orders</h2><a class="btn btn-quiet btn-sm" asp-controller="Purchasing" asp-action="Create">New purchase order</a></div>
                @if (!Model.Stock.Any()) { <div class="empty"><strong>Stock covers every open order</strong>Nothing is below its reorder level.</div> }
                else
                {
                    <div class="table-wrap"><table class="table">
                        <thead><tr><th>Equipment</th><th class="num">In stock</th><th class="num">Waiting</th><th class="num">Short by</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var s in Model.Stock)
                        {
                            <tr>
                                <td>@s.Product.Name<div class="muted small">Reorder level @s.Product.ReorderLevel</div></td>
                                <td class="num">@s.Product.StockQty</td><td class="num">@s.Demand</td>
                                <td class="num">@(s.Shortfall > 0 ? s.Shortfall.ToString() : "none")</td>
                                <td class="row-actions"><a asp-controller="Purchasing" asp-action="Create" asp-route-productId="@s.Product.Id">Order more</a></td>
                            </tr>
                        }
                        </tbody></table></div>
                }
            </div>
        </div>
        <div class="col-xl-5">
            <div class="panel">
                <div class="panel-head"><h2>Recent feedback</h2><a asp-controller="Feedback" asp-action="Index">All feedback</a></div>
                @if (!Model.Feedback.Any()) { <div class="empty">No feedback yet.</div> }
                <div class="panel-body">
                    @foreach (var f in Model.Feedback)
                    {
                        <div class="mb-3"><span class="rating">@(new string('★', f.Rating))@(new string('☆', 5 - f.Rating))</span> <strong>@f.Customer.FullName</strong><div class="muted small">@Fmt.Date(f.CreatedOn)</div><div>@f.Comments</div></div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="panel">
        <div class="panel-head"><h2>Recent orders</h2><a asp-controller="Orders" asp-action="Index">All orders</a></div>
        <partial name="_OrderTable" model="Model.Orders" />
    </div>
}
else if (Model.Role == Roles.Technical)
{
    <div class="page-head"><div><h1 class="page-title">Overview</h1><p class="page-sub">Orders that need a technician</p></div></div>
    <div class="stats">
        <div class="stat"><span class="figure">@Model.ToCheck</span><span class="label">To check for feasibility</span></div>
        <div class="stat"><span class="figure">@Model.ReadyToConnect</span><span class="label">Feasible, ready to connect</span></div>
        <div class="stat"><span class="figure">@Model.ActiveConnections</span><span class="label">Active connections</span></div>
    </div>
    <div class="panel">
        <div class="panel-head"><h2>Waiting on you</h2><a asp-controller="Orders" asp-action="Index">All orders</a></div>
        <partial name="_OrderTable" model="Model.Orders" />
    </div>
    <div class="row g-4 mt-0">
        <div class="col-xl-6">
            <div class="panel">
                <div class="panel-head"><h2>Bill overdue, still active</h2></div>
                @if (!Model.Connections.Any()) { <div class="empty">No active connection has an overdue bill.</div> }
                else
                {
                    <div class="table-wrap"><table class="table"><tbody>
                    @foreach (var c in Model.Connections)
                    {
                        <tr><td>@Ui.Id(c.AccountId)<div class="muted small">@c.Customer.FullName</div></td><td class="row-actions"><a asp-controller="Connections" asp-action="Details" asp-route-id="@c.Id">Review</a></td></tr>
                    }
                    </tbody></table></div>
                }
            </div>
        </div>
        <div class="col-xl-6">
            <div class="panel">
                <div class="panel-head"><h2>Equipment to watch</h2><a asp-controller="Products" asp-action="Index">All equipment</a></div>
                @if (!Model.Stock.Any()) { <div class="empty">Stock is healthy.</div> }
                else
                {
                    <div class="table-wrap"><table class="table"><tbody>
                    @foreach (var s in Model.Stock)
                    {
                        <tr><td>@s.Product.Name</td><td class="num">@s.Product.StockQty in stock</td><td class="num">@(s.Shortfall > 0 ? "short " + s.Shortfall : "low")</td></tr>
                    }
                    </tbody></table></div>
                }
            </div>
        </div>
    </div>
}
else if (Model.Role == Roles.Accounts)
{
    <div class="page-head"><div><h1 class="page-title">Overview</h1><p class="page-sub">Billing and collections</p></div>
        <div class="page-actions"><a class="btn btn-primary" asp-controller="Billing" asp-action="Pending">Bills to generate</a></div></div>
    <div class="stats">
        <div class="stat"><span class="figure">@Model.AwaitingBill</span><span class="label">Connections awaiting a bill</span></div>
        <div class="stat @(Model.OverdueCount > 0 ? "is-alert" : "")"><span class="figure">@Model.OverdueCount</span><span class="label">Overdue bills</span></div>
        <div class="stat"><span class="figure">@Fmt.Money(Model.OutstandingTotal)</span><span class="label">Outstanding</span></div>
        <div class="stat"><span class="figure">@Fmt.Money(Model.BilledThisMonth)</span><span class="label">Billed this month</span></div>
        <div class="stat"><span class="figure">@Fmt.Money(Model.CollectedThisMonth)</span><span class="label">Collected this month</span></div>
    </div>
    <div class="row g-4">
        <div class="col-xl-6">
            <div class="panel">
                <div class="panel-head"><h2>Next to bill</h2><a asp-controller="Billing" asp-action="Pending">See all</a></div>
                @if (!Model.Connections.Any()) { <div class="empty"><strong>Every connection is billed</strong>New connections appear here.</div> }
                else
                {
                    <div class="table-wrap"><table class="table"><tbody>
                    @foreach (var c in Model.Connections)
                    {
                        <tr><td>@Ui.Id(c.AccountId)<div class="muted small">@c.Customer.FullName, @c.Plan.Name</div></td>
                            <td class="row-actions"><a class="btn btn-quiet btn-sm" asp-controller="Billing" asp-action="Generate" asp-route-connectionId="@c.Id">Generate bill</a></td></tr>
                    }
                    </tbody></table></div>
                }
            </div>
        </div>
        <div class="col-xl-6">
            <div class="panel">
                <div class="panel-head"><h2>Overdue</h2><a asp-controller="Billing" asp-action="Index" asp-route-overdue="true">See all</a></div>
                @if (!Model.Bills.Any()) { <div class="empty">Nothing is overdue.</div> }
                else
                {
                    <div class="table-wrap"><table class="table"><tbody>
                    @foreach (var b in Model.Bills)
                    {
                        <tr class="is-overdue"><td><a asp-controller="Billing" asp-action="Details" asp-route-id="@b.Id">@b.BillNo</a><div class="muted small">@b.Connection.Customer.FullName, due @Fmt.Date(b.DueDate)</div></td><td class="num">@Fmt.Money(b.Due)</td></tr>
                    }
                    </tbody></table></div>
                }
            </div>
        </div>
    </div>
    @if (Model.PendingRefunds.Any())
    {
        <div class="panel">
            <div class="panel-head"><h2>Deposit refunds to pay</h2></div>
            <div class="table-wrap"><table class="table"><tbody>
            @foreach (var c in Model.PendingRefunds)
            {
                <tr><td>@Ui.Id(c.AccountId)<div class="muted small">@c.Customer.FullName</div></td><td class="num">@Fmt.Money(c.DepositRefundAmount ?? 0)</td>
                    <td class="row-actions"><a asp-controller="Connections" asp-action="Details" asp-route-id="@c.Id">Open</a></td></tr>
            }
            </tbody></table></div>
        </div>
    }
}
else if (Model.Role == Roles.Retail)
{
    <div class="page-head"><div><h1 class="page-title">Overview</h1><p class="page-sub">@Model.ShopName</p></div>
        <div class="page-actions"><a class="btn btn-primary" asp-controller="Customers" asp-action="Pick">@Ui.Icon("plus") New order</a>
            <a class="btn btn-quiet" asp-controller="Payments" asp-action="Index">Take a payment</a></div></div>
    <div class="stats">
        <div class="stat"><span class="figure">@Model.OpenOrders</span><span class="label">Orders in progress</span></div>
        <div class="stat"><span class="figure">@Model.ActiveConnections</span><span class="label">Active connections from this shop</span></div>
        <div class="stat"><span class="figure">@Fmt.Money(Model.CollectedToday)</span><span class="label">Collected today</span></div>
    </div>
    <div class="panel">
        <div class="panel-head"><h2>Recent orders from this shop</h2><a asp-controller="Orders" asp-action="Index">All orders</a></div>
        <partial name="_OrderTable" model="Model.Orders" />
    </div>
}
else
{
    <div class="page-head"><div><h1 class="page-title">Overview</h1><p class="page-sub">@(string.IsNullOrEmpty(first) ? "Your connections" : "Your connections, " + first)</p></div>
        <div class="page-actions"><a class="btn btn-primary" asp-controller="Orders" asp-action="Apply">@Ui.Icon("plus") Apply for a connection</a></div></div>
    <div class="stats">
        <div class="stat @(Model.OverdueCount > 0 ? "is-alert" : "")"><span class="figure">@Fmt.Money(Model.DueNow)</span><span class="label">@(Model.OverdueCount > 0 ? "Due, some of it overdue" : "Due now")</span></div>
        <div class="stat"><span class="figure">@Model.Connections.Count(c => c.Status == ConnectionStatus.Active)</span><span class="label">Active connections</span></div>
        <div class="stat"><span class="figure">@Model.Orders.Count</span><span class="label">Orders in progress</span></div>
    </div>
    <div class="panel">
        <div class="panel-head"><h2>Connections</h2></div>
        @if (!Model.Connections.Any()) { <div class="empty"><strong>No connections yet</strong>Apply for one and it will appear here once the technical team has connected it.</div> }
        else
        {
            <div class="table-wrap"><table class="table">
                <thead><tr><th>Account</th><th>Plan</th><th>Status</th><th class="num">Due</th><th></th></tr></thead>
                <tbody>
                @foreach (var c in Model.Connections)
                {
                    var due = Model.DueByConnection.TryGetValue(c.Id, out var d) ? d : 0m;
                    <tr><td>@Ui.Id(c.AccountId)<div class="muted small">@c.ConnectionType.Label(), @c.City.Name</div></td><td>@c.Plan.Name</td><td>@Ui.Status(c.Status)</td>
                        <td class="num">@Fmt.Money(due)</td><td class="row-actions"><a asp-controller="Connections" asp-action="Details" asp-route-id="@c.Id">Details</a></td></tr>
                }
                </tbody></table></div>
        }
    </div>
    @if (Model.Orders.Any())
    {
        <div class="panel">
            <div class="panel-head"><h2>Orders in progress</h2><a asp-controller="Orders" asp-action="Index">All orders</a></div>
            <partial name="_OrderTable" model="Model.Orders" />
        </div>
    }
}
