@model Paged<Customer>
@{ ViewData["Title"] = "Customers"; var q = (string)ViewBag.Q; }
<div class="page-head">
    <div><h1 class="page-title">Customers</h1><p class="page-sub">@Model.Total on record</p></div>
    <div class="page-actions">@if (User.IsInRole(Roles.Admin)) { <a class="btn btn-primary" asp-action="Create">@Ui.Icon("plus") Add customer</a> }</div>
</div>
<form method="get" class="filters">
    <div class="search"><span>@Ui.Icon("search", 15)</span><input class="form-control" type="search" name="q" value="@q" placeholder="Name, company, phone or email" aria-label="Search customers" /></div>
    <button class="btn btn-quiet" type="submit">Search</button>
    @if (!string.IsNullOrEmpty(q)) { <a class="btn-link-plain small" asp-action="Index">Clear</a> }
</form>
<div class="panel">
    @if (!Model.Items.Any()) { <div class="empty"><strong>No customers found</strong>Try part of the name or the last digits of the phone number.</div> }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Name</th><th>Type</th><th>Phone</th><th>City</th><th>Portal login</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model.Items)
            {
                <tr>
                    <td>@c.FullName@if (c.Kind == CustomerKind.Corporate) { <div class="muted small">@c.CompanyName</div> }</td>
                    <td>@c.Kind.Label()</td><td class="mono">@c.Phone</td><td>@c.City.Name</td>
                    <td>@(c.UserId != null ? "Yes" : "No")</td>
                    <td class="row-actions"><a asp-action="Details" asp-route-id="@c.Id">Open</a></td>
                </tr>
            }
            </tbody></table></div>
        <partial name="_Pager" model="(PagedBase)Model" />
    }
</div>
