@model Customer
@{ ViewData["Title"] = "Contact details"; }
<div class="page-head"><h1 class="page-title">Contact details</h1><div class="page-actions"><a class="btn btn-quiet" asp-action="EditProfile">@Ui.Icon("pencil") Edit</a></div></div>
<div class="panel"><div class="panel-body">
    <dl class="kv">
        <dt>Name</dt><dd>@Model.FullName</dd>
        @if (Model.Kind == CustomerKind.Corporate) { <dt>Company</dt><dd>@Model.CompanyName</dd> }
        <dt>Phone</dt><dd class="mono">@Model.Phone</dd>
        <dt>Email</dt><dd>@(Model.Email ?? "none")</dd>
        <dt>Address</dt><dd>@Model.Address, @Model.City.Name</dd>
        <dt>ID proof</dt><dd>@(string.IsNullOrEmpty(Model.IdProofType) ? "none on file" : Model.IdProofType + ", " + Model.IdProofNumber)</dd>
    </dl>
</div></div>
<p class="muted mt-3">To change your ID proof, visit a Nexus retail shop.</p>
