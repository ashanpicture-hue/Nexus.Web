@model Plan
@{ var editing = Model.Id != 0; ViewData["Title"] = editing ? "Edit plan" : "Add plan"; }
<a class="back-link" asp-action="Index">@Ui.Icon("arrow-left", 14) Plans</a>
<div class="page-head"><h1 class="page-title">@ViewData["Title"]</h1></div>
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : (int?)null)" method="post" novalidate>
    <partial name="_Summary" />
    <div class="panel"><div class="panel-body">
        <div class="form-grid">
            <div><label class="form-label" asp-for="Name">Plan name</label><input class="form-control" asp-for="Name" /><span asp-validation-for="Name" class="field-validation-error"></span></div>
            <div class="c-4"><label class="form-label" asp-for="ConnectionType">Connection type</label><select class="form-select" asp-for="ConnectionType" asp-items="EnumExt.Options<ConnectionType>(Model.ConnectionType)"></select></div>
            <div class="c-4"><label class="form-label" asp-for="Category">Category</label><select class="form-select" asp-for="Category" asp-items="EnumExt.Options<PlanCategory>(Model.Category)"></select></div>
            <div class="c-4"><label class="form-label" asp-for="ValidityMonths">Covers (months)</label><input class="form-control mono" asp-for="ValidityMonths" type="number" min="1" max="60" /><div class="hint">One rental, and one bill, covers this long.</div><span asp-validation-for="ValidityMonths" class="field-validation-error"></span></div>
            <div class="c-4"><label class="form-label" asp-for="Price">Price</label><div class="input-money"><input class="form-control" asp-for="Price" type="number" step="0.01" min="0" /></div><span asp-validation-for="Price" class="field-validation-error"></span></div>
            <div class="c-4"><label class="form-label" asp-for="SpeedKbps">Speed (Kbps)</label><input class="form-control mono" asp-for="SpeedKbps" type="number" min="0" /></div>
            <div class="c-4"><label class="form-label" asp-for="Hours">Hours included</label><input class="form-control mono" asp-for="Hours" type="number" min="0" /></div>
        </div>
        <div class="form-section">
            <h2>Call charges per minute</h2>
            <p class="muted mb-3">Landline plans only. Leave empty where the plan has no such charge.</p>
            <div class="form-grid">
                <div class="c-4"><label class="form-label" asp-for="LocalRate">Local</label><div class="input-money"><input class="form-control" asp-for="LocalRate" type="number" step="0.01" min="0" /></div></div>
                <div class="c-4"><label class="form-label" asp-for="StdRate">STD</label><div class="input-money"><input class="form-control" asp-for="StdRate" type="number" step="0.01" min="0" /></div></div>
                <div class="c-4"><label class="form-label" asp-for="MobileMsgRate">Mobile messaging</label><div class="input-money"><input class="form-control" asp-for="MobileMsgRate" type="number" step="0.01" min="0" /></div></div>
            </div>
        </div>
        <div class="form-section">
            <div class="form-grid">
                <div><label class="form-label" asp-for="Description">Description</label><input class="form-control" asp-for="Description" /></div>
                <div><div class="form-check"><input class="form-check-input" type="checkbox" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive">Offered to new customers</label></div></div>
            </div>
        </div>
        <div class="form-actions"><button class="btn btn-primary" type="submit" data-busy="Saving">Save plan</button><a class="btn btn-quiet" asp-action="Index">Cancel</a></div>
    </div></div>
</form>
