@model Vendor
@{ var editing = Model.Id != 0; ViewData["Title"] = editing ? "Edit vendor" : "Add vendor"; }
<a class="back-link" asp-action="Index">@Ui.Icon("arrow-left", 14) Vendors</a>
<div class="page-head"><h1 class="page-title">@ViewData["Title"]</h1></div>
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : (int?)null)" method="post" novalidate>
    <partial name="_Summary" />
    <div class="panel"><div class="panel-body"><div class="form-grid">
        <div class="c-6"><label class="form-label" asp-for="Name">Vendor name</label><input class="form-control" asp-for="Name" /><span asp-validation-for="Name" class="field-validation-error"></span></div>
        <div class="c-6"><label class="form-label" asp-for="ContactPerson">Contact person</label><input class="form-control" asp-for="ContactPerson" /></div>
        <div class="c-6"><label class="form-label" asp-for="Phone">Phone</label><input class="form-control mono" asp-for="Phone" type="tel" /><span asp-validation-for="Phone" class="field-validation-error"></span></div>
        <div class="c-6"><label class="form-label" asp-for="Email">Email</label><input class="form-control" asp-for="Email" type="email" /><span asp-validation-for="Email" class="field-validation-error"></span></div>
        <div><label class="form-label" asp-for="Address">Address</label><input class="form-control" asp-for="Address" /></div>
        <div><div class="form-check"><input class="form-check-input" type="checkbox" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive">Currently used</label></div></div>
    </div>
    <div class="form-actions"><button class="btn btn-primary" type="submit" data-busy="Saving">Save vendor</button><a class="btn btn-quiet" asp-action="Index">Cancel</a></div></div></div>
</form>
