@model ServiceOrder
@{
    ViewData["Title"] = "Order " + Model.OrderNo;
    var isTech = User.IsInRole(Roles.Technical);
    var closed = Model.Status == OrderStatus.ConnectionProvided || Model.Status == OrderStatus.Cancelled;
    var needsLandline = Model.ConnectionType == ConnectionType.DialUp && !Model.HasExistingLandline;
    var required = FeasibilityRules.Required(Model.ConnectionType, Model.HasExistingLandline);
    var latest = Model.FeasibilityChecks.GroupBy(c => c.Subject).ToDictionary(g => g.Key, g => g.OrderByDescending(c => c.CheckedOn).ThenByDescending(c => c.Id).First());
    var maxKm = (Dictionary<FeasibilitySubject, decimal>)ViewBag.MaxKm;
    var products = ViewBag.Products as List<Product> ?? new List<Product>();
    var canCancel = !closed && (User.IsInRole(Roles.Retail) || User.IsInRole(Roles.Customer) || User.IsInRole(Roles.Admin));
}
<a class="back-link" asp-action="Index">@Ui.Icon("arrow-left", 14) Orders</a>
<div class="page-head">
    <div>
        <div class="mb-2">@Ui.Id(Model.OrderNo)</div>
        <h1 class="page-title">@Model.ConnectionType.Label() order@(Model.Quantity > 1 ? ", " + Model.Quantity + " connections" : "")</h1>
        <p class="page-sub">@Model.Customer.FullName · placed @Fmt.DateTimeText(Model.PlacedOn) · @Ui.Status(Model.Status)</p>
    </div>
    <div class="page-actions">
        @if (isTech && Model.Status == OrderStatus.Placed)
        {
            <form asp-action="StartCheck" asp-route-id="@Model.Id" method="post"><button class="btn btn-quiet" type="submit">Start feasibility check</button></form>
        }
    </div>
</div>

<div class="panel"><div class="panel-body"><partial name="_OrderWire" model="Model" /></div></div>

<div class="row g-4 mt-0">
    <div class="col-xl-7">
        <div class="panel">
            <div class="panel-head"><h2>Order</h2></div>
            <div class="panel-body">
                <dl class="kv kv-tight">
                    <dt>Customer</dt>
                    <dd>@if (!User.IsInRole(Roles.Customer)) { <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer.FullName</a> } else { @Model.Customer.FullName }
                        @if (Model.Customer.Kind == CustomerKind.Corporate) { <span class="muted">, @Model.Customer.CompanyName</span> }</dd>
                    <dt>Plan</dt><dd>@Model.Plan.Name, @Fmt.Money(Model.Plan.Price)</dd>
                    <dt>Equipment</dt><dd>@(Model.Product?.Name ?? "To be decided at installation")</dd>
                    <dt>Connections</dt><dd>@Model.Quantity</dd>
                    @if (Model.ConnectionType == ConnectionType.DialUp)
                    {
                        <dt>Landline</dt>
                        <dd>@if (Model.HasExistingLandline) { <span>Existing, </span>@Ui.Id(Model.ExistingLandlineAccountId) } else { <span>New, @(Model.LandlinePlan?.Name)</span> }</dd>
                    }
                    <dt>Installation</dt><dd>@Model.InstallAddress, @Model.InstallCity.Name</dd>
                    <dt>Placed through</dt><dd>@(Model.Channel == OrderChannel.RetailShop ? Model.RetailShop?.Name : "Online application")</dd>
                    <dt>Bulk discount</dt><dd>@(Model.DiscountPercent > 0 ? Fmt.Percent(Model.DiscountPercent) + " off first rental and deposit" : "None")</dd>
                    @if (!string.IsNullOrEmpty(Model.Remarks)) { <dt>Remarks</dt><dd>@Model.Remarks</dd> }
                </dl>
            </div>
        </div>

        @if (Model.Connections.Any())
        {
            <div class="panel">
                <div class="panel-head"><h2>Connections made</h2></div>
                <div class="table-wrap"><table class="table"><tbody>
                @foreach (var c in Model.Connections.OrderBy(c => c.AccountId))
                {
                    <tr><td>@Ui.Id(c.AccountId)</td><td>@c.ConnectionType.Label()</td><td>@Ui.Status(c.Status)</td>
                        <td class="row-actions"><a asp-controller="Connections" asp-action="Details" asp-route-id="@c.Id">Open</a></td></tr>
                }
                </tbody></table></div>
            </div>
        }

        <div class="panel">
            <div class="panel-head"><h2>Documents</h2></div>
            @if (!Model.Documents.Any()) { <div class="empty">No documents were filed with this order.</div> }
            else
            {
                <div class="table-wrap"><table class="table"><tbody>
                @foreach (var d in Model.Documents)
                {
                    <tr><td>@Ui.Icon("paperclip") @d.Kind.Label()<div class="muted small">@d.OriginalName</div></td><td>@Fmt.Date(d.UploadedOn)</td>
                        <td class="row-actions"><a asp-action="Document" asp-route-id="@d.Id">Download</a></td></tr>
                }
                </tbody></table></div>
            }
        </div>
    </div>

    <div class="col-xl-5">
        <div class="panel">
            <div class="panel-head"><h2>Feasibility</h2></div>
            <div class="panel-body">
                @foreach (var subject in required)
                {
                    latest.TryGetValue(subject, out var check);
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <strong>@subject.Label()</strong>
                            @if (check != null) { <span class="status"><i class="dot @(check.IsFeasible ? "dot-green" : "dot-red")"></i>@(check.IsFeasible ? "Feasible" : "Not feasible")</span> }
                            else { <span class="muted small">Not checked</span> }
                        </div>
                        @if (check != null)
                        {
                            <div class="muted small">@check.DistanceKm.ToString("0.##") km@(subject == FeasibilitySubject.Internet ? (check.ServerAvailable ? ", server available" : ", no server capacity") : ""). @check.Remarks</div>
                        }
                        @if (isTech && !closed)
                        {
                            <form asp-action="Feasibility" method="post" class="mt-2">
                                <input type="hidden" name="OrderId" value="@Model.Id" />
                                <input type="hidden" name="Subject" value="@((int)subject)" />
                                <div class="row g-2 align-items-end">
                                    <div class="col-5">
                                        <label class="form-label small mb-1" for="km-@((int)subject)">Distance (km)</label>
                                        <input id="km-@((int)subject)" class="form-control mono" name="DistanceKm" type="number" step="0.1" min="0" inputmode="decimal" value="@(check?.DistanceKm.ToString("0.##"))" required />
                                    </div>
                                    @if (subject == FeasibilitySubject.Internet)
                                    {
                                        <div class="col-7">
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="checkbox" id="srv-@((int)subject)" name="ServerAvailable" value="true" checked="@(check?.ServerAvailable ?? true)" />
                                                <input type="hidden" name="ServerAvailable" value="false" />
                                                <label class="form-check-label" for="srv-@((int)subject)">Server has room</label>
                                            </div>
                                        </div>
                                    }
                                    <div class="col-12"><input class="form-control" name="Remarks" placeholder="Note, for example cabinet or route" aria-label="Note" /></div>
                                    <div class="col-12 d-flex align-items-center gap-3">
                                        <button class="btn btn-quiet btn-sm" type="submit">@(check == null ? "Record check" : "Check again")</button>
                                        <span class="hint mt-0">Limit @maxKm[subject].ToString("0.##") km</span>
                                    </div>
                                </div>
                            </form>
                        }
                    </div>
                }
                @if (!isTech && !Model.FeasibilityChecks.Any()) { <p class="muted mb-0">The technical team has not checked this address yet.</p> }
            </div>
        </div>

        @if (isTech && Model.Status == OrderStatus.Feasible)
        {
            <div class="panel">
                <div class="panel-head"><h2>Create the connection@(Model.Quantity > 1 ? "s" : "")</h2></div>
                <div class="panel-body">
                    <form asp-action="Provision" method="post">
                        <input type="hidden" name="OrderId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label" for="ProductId">Equipment to issue</label>
                            <select class="form-select" id="ProductId" name="ProductId">
                                <option value="">None</option>
                                @foreach (var p in products.Where(p => OrderService.ProductFits(Model.ConnectionType, p.Category)))
                                {
                                    <option value="@p.Id" selected="@(Model.ProductId == p.Id)" disabled="@(p.StockQty < Model.Quantity)">@p.Name (@p.StockQty in stock)</option>
                                }
                            </select>
                            <div class="hint">@Model.Quantity needed.</div>
                        </div>
                        @if (needsLandline)
                        {
                            <div class="mb-3">
                                <label class="form-label" for="LandlineProductId">Telephone set for the new landline</label>
                                <select class="form-select" id="LandlineProductId" name="LandlineProductId">
                                    <option value="">None</option>
                                    @foreach (var p in products.Where(p => p.Category == ProductCategory.Telephone))
                                    {
                                        <option value="@p.Id" disabled="@(p.StockQty < Model.Quantity)">@p.Name (@p.StockQty in stock)</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label" for="Serials">Serial numbers <span class="muted">(one per line, optional)</span></label>
                            <textarea class="form-control mono" id="Serials" name="Serials" rows="3"></textarea>
                        </div>
                        <button class="btn btn-primary" type="submit" data-busy="Connecting">Create connection@(Model.Quantity > 1 ? "s" : "")</button>
                        <p class="hint">@(needsLandline ? "This also creates a landline for each dial-up connection. " : "")Each connection gets its own account id. The first bill is generated by the accounts department.</p>
                    </form>
                </div>
            </div>
        }

        @if (canCancel)
        {
            <div class="panel">
                <div class="panel-head"><h2>Cancel this order</h2></div>
                <div class="panel-body">
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                        <label class="form-label" for="reason">Reason</label>
                        <input class="form-control mb-3" id="reason" name="reason" maxlength="200" />
                        <button class="btn btn-danger-quiet" type="button" data-confirm="Order @Model.OrderNo will be cancelled and cannot be reopened." data-confirm-title="Cancel this order?" data-confirm-verb="Cancel order">Cancel order</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
