@model ChangePasswordVm
@{ ViewData["Title"] = "Change password"; }
<div class="page-head"><h1 class="page-title">Change password</h1></div>
<div class="panel form-narrow"><div class="panel-body">
    <form asp-action="Password" method="post" novalidate>
        <partial name="_Summary" />
        <div class="mb-3"><label class="form-label" asp-for="Current"></label><input class="form-control" asp-for="Current" autocomplete="current-password" /><span asp-validation-for="Current" class="field-validation-error"></span></div>
        <div class="mb-3"><label class="form-label" asp-for="New"></label><input class="form-control" asp-for="New" autocomplete="new-password" /><div class="hint">8 or more characters, with a letter and a digit</div><span asp-validation-for="New" class="field-validation-error"></span></div>
        <div class="mb-3"><label class="form-label" asp-for="Repeat"></label><input class="form-control" asp-for="Repeat" autocomplete="new-password" /><span asp-validation-for="Repeat" class="field-validation-error"></span></div>
        <div class="form-actions"><button class="btn btn-primary" type="submit">Change password</button><a class="btn btn-quiet" asp-controller="Dashboard" asp-action="Index">Cancel</a></div>
    </form>
</div></div>
