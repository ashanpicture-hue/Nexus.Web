@model LoginVm
@{
    ViewData["Title"] = "Sign in";
    Layout = "_BareLayout";
}
<div class="auth-split">
    <section class="auth-side">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true"><circle cx="5" cy="13" r="3.2" fill="currentColor"/><circle cx="21" cy="13" r="3.2" fill="currentColor"/><path d="M8.2 13h9.6" stroke="currentColor" stroke-width="2"/></svg>
            <span>Nexus</span>
        </a>
        <div>
            <h2>Orders, connections and bills in one place</h2>
            <p>Staff sign in with the username the Admin gave them. Customers use the account they created when applying.</p>
        </div>
        <span class="small">Nexus Communication System</span>
    </section>
    <section class="auth-form">
        <div class="inner">
            <h1>Sign in</h1>
            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <partial name="_Summary" />
                <div class="mb-3">
                    <label class="form-label" asp-for="Username">Username</label>
                    <input class="form-control" asp-for="Username" autocomplete="username" autofocus spellcheck="false" />
                    <span asp-validation-for="Username" class="field-validation-error"></span>
                </div>
                <div class="mb-4">
                    <label class="form-label" asp-for="Password">Password</label>
                    <input class="form-control" asp-for="Password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <button class="btn btn-primary w-100" type="submit" data-busy="Signing in">Sign in</button>
            </form>
            <p class="muted mt-4 mb-0">New customer? <a asp-action="Register">Create an account</a></p>
        </div>
    </section>
</div>
