@model Paged<Connection>
@{
    ViewData["Title"] = User.IsInRole(Roles.Customer) ? "My connections" : "Connections";
    var status = (ConnectionStatus?)ViewBag.Status;
    var type = (ConnectionType?)ViewBag.Type;
    var q = (string)ViewBag.Q;
    var due = (Dictionary<int, decimal>)ViewBag.Due;
}
<div class="page-head"><div><h1 class="page-title">@ViewData["Title"]</h1><p class="page-sub">@Model.Total @(Model.Total == 1 ? "connection" : "connections")</p></div></div>
<form method="get" class="filters">
    <div class="search"><span>@Ui.Icon("search", 15)</span><input class="form-control" type="search" name="q" value="@q" placeholder="Account id or customer name" aria-label="Search connections" /></div>
    <select class="form-select" name="type" aria-label="Type"><option value="">All types</option>@foreach (var t in Enum.GetValues<ConnectionType>()) { <option value="@((int)t)" selected="@(type == t)">@t.Label()</option> }</select>
    <select class="form-select" name="status" aria-label="Status"><option value="">All statuses</option>@foreach (var s in Enum.GetValues<ConnectionStatus>()) { <option value="@((int)s)" selected="@(status == s)">@s.Label()</option> }</select>
    <button class="btn btn-quiet" type="submit">Filter</button>
    @if (status != null || type != null || !string.IsNullOrEmpty(q)) { <a class="btn-link-plain small" asp-action="Index">Clear</a> }
</form>
<div class="panel">
    @if (!Model.Items.Any()) { <div class="empty"><strong>No connections found</strong>Connections appear here after the technical team creates them from a feasible order.</div> }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Account</th><th>Customer</th><th>Plan</th><th>City</th><th>Status</th><th class="num">Due</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model.Items)
            {
                var d = due.TryGetValue(c.Id, out var v) ? v : 0m;
                <tr>
                    <td>@Ui.Id(c.AccountId)</td><td>@c.Customer.FullName</td><td>@c.Plan.Name</td><td>@c.City.Name</td>
                    <td>@Ui.Status(c.Status)</td><td class="num">@Fmt.Money(d)</td>
                    <td class="row-actions"><a asp-action="Details" asp-route-id="@c.Id">Open</a></td>
                </tr>
            }
            </tbody></table></div>
        <partial name="_Pager" model="(PagedBase)Model" />
    }
</div>
