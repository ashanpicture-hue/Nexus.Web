@model List<RetailShop>
@{ ViewData["Title"] = "Retail shops"; var q = (string)ViewBag.Q; }
<div class="page-head"><div><h1 class="page-title">Retail shops</h1><p class="page-sub">@Model.Count shops</p></div><div class="page-actions"><a class="btn btn-primary" asp-action="Create">@Ui.Icon("plus") Add shop</a></div></div>
<form method="get" class="filters"><div class="search"><span>@Ui.Icon("search", 15)</span><input class="form-control" type="search" name="q" value="@q" placeholder="Shop or city" aria-label="Search shops" /></div><button class="btn btn-quiet" type="submit">Search</button></form>
<div class="panel">
    @if (!Model.Any()) { <div class="empty"><strong>No shops found</strong></div> }
    else
    {
        <div class="table-wrap"><table class="table">
            <thead><tr><th>Shop</th><th>City</th><th>Address</th><th>Phone</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr><td>@s.Name</td><td>@s.City.Name</td><td>@s.Address</td><td class="mono">@s.Phone</td><td>@Ui.Active(s.IsActive)</td>
                    <td class="row-actions"><a asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"><button type="button" class="btn-link-plain text-danger" data-confirm="@s.Name will be deleted, or retired if it has history." data-confirm-title="Delete this shop?" data-confirm-verb="Delete shop">Delete</button></form></td></tr>
            }
            </tbody></table></div>
    }
</div>
