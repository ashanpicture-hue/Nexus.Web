@model PagedBase
@{
    // Keep every other filter in the address when moving between pages.
    string Link(int p)
    {
        var pairs = Context.Request.Query.Where(k => k.Key != "page")
            .Select(k => Uri.EscapeDataString(k.Key) + "=" + Uri.EscapeDataString(k.Value.ToString())).ToList();
        pairs.Add("page=" + p);
        return Context.Request.Path + "?" + string.Join("&", pairs);
    }
    var from = Model.Total == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var to = Math.Min(Model.Total, Model.Page * Model.PageSize);
}
@if (Model.Total > 0)
{
    <div class="pager">
        <span>@from to @to of @Model.Total</span>
        @if (Model.Pages > 1)
        {
            <span class="d-flex gap-2">
                @if (Model.Page > 1) { <a class="btn btn-quiet btn-sm" href="@Link(Model.Page - 1)">Previous</a> }
                @if (Model.Page < Model.Pages) { <a class="btn btn-quiet btn-sm" href="@Link(Model.Page + 1)">Next</a> }
            </span>
        }
    </div>
}
