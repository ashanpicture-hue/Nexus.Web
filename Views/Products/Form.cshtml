@model Product
@{ var editing = Model.Id != 0; ViewData["Title"] = editing ? "Edit equipment" : "Add equipment"; var vendors = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Vendors; }
<a class="back-link" asp-action="Index">@Ui.Icon("arrow-left", 14) Equipment</a>
<div class="page-head"><h1 class="page-title">@ViewData["Title"]</h1></div>
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : (int?)null)" method="post" novalidate>
    <partial name="_Summary" />
    <div class="panel"><div class="panel-body"><div class="form-grid">
        <div class="c-6"><label class="form-label" asp-for="Name">Name</label><input class="form-control" asp-for="Name" /><span asp-validation-for="Name" class="field-validation-error"></span></div>
        <div class="c-3"><label class="form-label" asp-for="Category">Category</label><select class="form-select" asp-for="Category" asp-items="EnumExt.Options<ProductCategory>(Model.Category)"></select></div>
        <div class="c-3"><label class="form-label" asp-for="Model">Model</label><input class="form-control mono" asp-for="Model" /></div>
        <div class="c-6"><label class="form-label" asp-for="VendorId">Usual vendor</label><select class="form-select" asp-for="VendorId" asp-items="vendors"><option value="">None</option></select></div>
        <div class="c-6"><label class="form-label" asp-for="ReplacementCharge">Replacement charge</label><div class="input-money"><input class="form-control" asp-for="ReplacementCharge" type="number" step="0.01" min="0" /></div><div class="hint">Charged to the customer when they damage or lose the unit.</div></div>
        <div class="c-6"><label class="form-label" asp-for="StockQty">In stock</label><input class="form-control mono" asp-for="StockQty" type="number" min="0" /><span asp-validation-for="StockQty" class="field-validation-error"></span></div>
        <div class="c-6"><label class="form-label" asp-for="ReorderLevel">Reorder level</label><input class="form-control mono" asp-for="ReorderLevel" type="number" min="0" /><div class="hint">The dashboard flags the item at or below this number.</div></div>
        <div><label class="form-label" asp-for="Description">Description</label><input class="form-control" asp-for="Description" /></div>
        <div><div class="form-check"><input class="form-check-input" type="checkbox" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive">Available to issue</label></div></div>
    </div>
    <div class="form-actions"><button class="btn btn-primary" type="submit" data-busy="Saving">Save equipment</button><a class="btn btn-quiet" asp-action="Index">Cancel</a></div></div></div>
</form>
